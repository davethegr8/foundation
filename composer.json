{
    "name": "hep/foundation",
    "description": "",
    "require": {
        "php": ">=8.0.7",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpmd/phpmd": "^2.6"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-text=docs/coverage/coverage.txt --coverage-html docs/coverage",
        "phpmd": "vendor/bin/phpmd ./src/ html cleancode,codesize,controversial,design,naming,unusedcode --ignore-violations-on-exit --reportfile docs/phpmd.html"
    },
    "autoload": {
        "psr-4": {"Hep\\Foundation\\": "src/"},
        "files": [
            "src/helpers.php"
        ]
    }
}
